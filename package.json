{
	"name": "outline-plus",
	"version": "1.0.11",
	"description": "Quick heading navigation palette for Obsidian",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"deploy": "npm run build && node scripts/deploy.mjs",
		"deploy:only": "node scripts/deploy.mjs",
		"check:version": "node scripts/check-version.mjs",
		"version": "npm run build && node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest run",
		"lint": "eslint .",
		"postversion": "git push origin main --follow-tags && gh release create $npm_package_version main.js manifest.json --generate-notes"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "9.30.1",
		"@eslint/json": "^0.14.0",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^20.19.41",
		"@typescript-eslint/eslint-plugin": "^8.35.1",
		"@typescript-eslint/parser": "^8.35.1",
		"@typescript-eslint/utils": "^8.35.1",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "^0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"jsdom": "^29.1.1",
		"obsidian": "^1.12.3",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "^4.1.7"
	}
}
